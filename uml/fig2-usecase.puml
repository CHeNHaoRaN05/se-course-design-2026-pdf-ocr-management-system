  usecase "UC11 表格还原" as UC11
  usecase "UC12 导出识别结果" as UC12
  usecase "UC13 全文检索" as UC13
  usecase "UC14 生成分享链接" as UC14
  usecase "UC15 访问分享内容" as UC15
