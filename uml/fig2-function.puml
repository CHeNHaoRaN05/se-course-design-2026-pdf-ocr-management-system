' ==========================================================
' 图 2-1  系统功能结构图
' 自然尺寸（PlantUML @ 默认 dpi）见 图例绘制规格.md 实测表
' ==========================================================
@startuml 图2-1_系统功能结构图
title 图2-1  系统功能结构图

skinparam defaultFontName "Microsoft YaHei"
skinparam defaultFontSize 26
skinparam shadowing false
skinparam ArrowFontSize 22
skinparam ArrowColor #2C3E50
skinparam DefaultFontColor #1F2933
skinparam PackageBackgroundColor #FDFEFE
skinparam PackageBorderColor #85929E
skinparam RectangleBackgroundColor #EAF2F8
skinparam DatabaseBackgroundColor #FDEDEC
skinparam RectangleBorderColor #5D6D7E

package "① 展现层    React + pdf.js" as L1 {
  rectangle "文件管理界面" as F1
  rectangle "PDF 阅读器" as F2
  rectangle "结果校对台" as F3
  rectangle "检索与导出" as F4
  rectangle "管理控制台" as F5
}

package "② 功能模块层" as L2 {
  rectangle "用户与权限" as M1
  rectangle "文件管理" as M2
  rectangle "在线阅读" as M3
  rectangle "OCR 识别" as M4
  rectangle "校对导出" as M5
  rectangle "全文检索" as M6
  rectangle "分享" as M7
  rectangle "日志统计" as M8
}

package "③ 服务层" as L3 {
  rectangle "JWT 鉴权" as S1
  rectangle "队列与租约" as S2
  rectangle "推理调度" as S3
  rectangle "全文索引" as S4
  rectangle "导出渲染" as S5
  rectangle "审计与配额" as S6
}

package "④ 数据层" as L4 {
  database "MySQL 8" as D1
  database "全文索引" as D2
  database "本地存储" as D3
  database "模型权重" as D4
}

L1 -down-> L2 : 发起操作
L2 -down-> L3 : 调用服务
L3 -down-> L4 : 读写数据

note bottom of L2
  需求编号：FR-USER / FR-FILE / FR-READ / FR-OCR
           FR-COR / FR-EXP / FR-SEA / FR-LOG
end note
@enduml


' ==========================================================
' 图 2-2  文件生命周期状态图
' ==========================================================
@startuml 图2-2_文件生命周期状态图
title 图2-2  文件生命周期状态图

skinparam defaultFontName "Microsoft YaHei"
skinparam defaultFontSize 26
skinparam shadowing false
skinparam ArrowFontSize 22
skinparam ArrowColor #2C3E50
skinparam DefaultFontColor #1F2933
skinparam StateBackgroundColor #EAF2F8
skinparam StateBorderColor #5D6D7E
skinparam NoteBackgroundColor #FCF3CF

[*] --> UPLOAD : 选择本地文件

state "上传中" as UPLOAD : 写入过程中，进度可见
state "待识别" as READY : 校验通过，等待提交任务
state "识别中" as RUNNING : 存在活动任务
state "已识别" as OK : 全部页成功
state "部分成功" as PARTIAL : 存在失败页
state "识别失败" as FAILED : 全部页失败
state "已归档" as ARCHIVED : 用户归档
state "回收站" as TRASH : 软删除，保留 30 天

UPLOAD --> READY : 校验通过
UPLOAD --> [*] : 校验失败 / 取消
READY --> RUNNING : 提交任务 (generation+1)
RUNNING --> OK : succeeded
RUNNING --> PARTIAL : partial_success
RUNNING --> FAILED : failed
RUNNING --> READY : 取消 / 租约丢失
OK --> RUNNING : 改参数重识别
OK --> ARCHIVED : 归档
PARTIAL --> ARCHIVED : 归档并标注失败页
PARTIAL --> RUNNING : 任务级 retry
FAILED --> RUNNING : 整册 retry
ARCHIVED --> READY : 取出再识别
OK --> TRASH : 删除
PARTIAL --> TRASH : 删除
FAILED --> TRASH : 删除
ARCHIVED --> TRASH : 删除
TRASH --> [*] : 超过保留期

note right of READY
  generation 随新建任务递增，
  旧代次结果不得覆盖新代次。
end note
@enduml


' ==========================================================
' 图 2-3a  OCR 任务创建与入队活动图（带泳道）
' ==========================================================
@startuml 图2-3a_任务创建与入队活动图
title 图2-3a  OCR 任务创建与入队活动图

skinparam defaultFontName "Microsoft YaHei"
skinparam defaultFontSize 26
skinparam shadowing false
skinparam ArrowFontSize 22
skinparam ArrowColor #2C3E50
skinparam DefaultFontColor #1F2933
skinparam ActivityBackgroundColor #EAF2F8
skinparam ActivityBorderColor #5D6D7E
skinparam ConditionBackgroundColor #FCF3CF

|#D6EAF8|浏览器|
start
:选择文件、页码范围与识别选项;
:POST /jobs 提交识别请求;

|#E8F8F5|API 服务|
:JWT 鉴权 + 文件归属校验;
:校验页号范围合法性;
if (存在活动任务?) then (是)
  :返回 409 E_JOB_ACTIVE;
else (否)
  :before_enqueue 预留页数配额;
  if (配额不足?) then (是)
    :返回 429 E_QUOTA_EXCEEDED;
  else (否)
    :file.generation + 1;
    :创建 Job (queued)\n逐页创建 Page (pending);
    :写 ocr_audit_log (job_created);
    :返回 202 JobOut (job_id);
  endif
endif

|#FDFEFE|任务队列 (MySQL)|
:等待 available_at 到期;
:worker 条件更新领取\nstatus=running, attempts+1\nlease_token, lease_until=now+120s;

|#D6EAF8|浏览器|
:获得 job_id，开始轮询任务进度;
stop
@enduml


' ==========================================================
' 图 2-3b  OCR 逐页识别与结果回写活动图（带泳道）
' ==========================================================
@startuml 图2-3b_逐页识别与结果回写活动图
title 图2-3b  OCR 逐页识别与结果回写活动图

skinparam defaultFontName "Microsoft YaHei"
skinparam defaultFontSize 26
skinparam shadowing false
skinparam ArrowFontSize 22
skinparam ArrowColor #2C3E50
skinparam DefaultFontColor #1F2933
skinparam ActivityBackgroundColor #EAF2F8
skinparam ActivityBorderColor #5D6D7E
skinparam ConditionBackgroundColor #FCF3CF

|#F4ECF7|OCR Worker|
start
fork
  :心跳线程：每 40 秒续租 120 秒;
fork again
  :读取原文件并按页渲染 (EXIF 校正);
  repeat
    :取下一页并做像素校验;
    :透视校正与预处理;
    :文本检测 det → 文字框;
    :裁剪 → 识别 rec → CTC 解码;
    if (开启表格还原?) then (是)
      :提取线框并填充单元格;
    else (否)
    endif
    :重排阅读顺序;
    if (本页成功?) then (是)
      :写 ocr_pages 成功 + revision;
      :同事务 upsert pdf_text_index;
    else (否)
      :写 ocr_pages 失败 + error;
    endif
  repeat while (仍有未处理页?) is (是)
  ->否;
  :释放文件 active_job_id;
end fork

|#E8F8F5|API 服务|
if (存在失败页 且 attempts < 3?) then (是)
  :status = retry_wait\navailable_at = now + 15·2^(attempts-1) 秒;
else (否)
  if (全部页成功?) then (是)
    :status = succeeded;
  else (否)
    if (存在成功页?) then (是)
      :status = partial_success;
    else (否)
      :status = failed;
    endif
  endif
  :写 ocr_audit_log 记录提交明细;
endif

|#D6EAF8|浏览器|
:轮询展示页级进度与失败页码;
:任务终态后进入校对 / 导出;
stop
@enduml
