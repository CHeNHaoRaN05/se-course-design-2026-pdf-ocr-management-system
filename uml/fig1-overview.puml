' ==========================================================
' 图 1-1  系统上下文图
' 建议幅面：通栏 14.6 x 7.5 cm（约 2/3 页宽，半页高）
' 渲染：java -jar plantuml.jar -tsvg -charset UTF-8 -DPLANTUML_LIMIT_SIZE=16384 fig1-overview.puml
' ==========================================================
@startuml 图1-1_系统上下文图
title 图1-1  系统上下文图

skinparam defaultFontName "Microsoft YaHei"
skinparam defaultFontSize 26
skinparam shadowing false
skinparam componentStyle uml2
skinparam ArrowColor #2C3E50
skinparam DefaultFontColor #1F2933
skinparam ArrowFontSize 22
skinparam nodeBackgroundColor #FDFEFE
skinparam componentBackgroundColor #EAF2F8
skinparam databaseBackgroundColor #FDEDEC
skinparam cloudBackgroundColor #F8F9F9

actor "普通用户 user" as U1
actor "只读用户 viewer" as U2
actor "管理员 admin" as U3
actor "游客 guest" as U4

node "基于本地 OCR 的 PDF 文件显示与管理系统" as SYS {
  component "Web 前端\n(React + pdf.js)" as FE
  component "后端服务\n(FastAPI)" as API
  component "OCR Worker\n(PaddleOCR 本地推理)" as WK
  database "MySQL 8\n业务表 + pdf_text_index" as DB
  database "本地文件存储\nocr_data/" as FS
}

cloud "操作系统本地磁盘\n(待归档 PDF / 导出文件落地)" as DISK
cloud "模型权重目录\nmodels/ 离线分发 + SHA256 校验" as MODEL

U1 -down-> FE
U2 -down-> FE
U3 -down-> FE
U4 -down-> FE : 分享链接 / 只读

FE -right-> API : REST / JSON
API -down-> DB : TCP :3306
API -right-> FS : 文件读写
WK -up-> DB : 领取任务 / 回写页结果与索引
WK -down-> FS : 读原文件 / 写页图
FE -down-> DISK : 下载导出文件
DISK -down-> SYS : 导入待归档 PDF
MODEL -up-> WK : 加载 det / rec 权重

note bottom of SYS
  系统边界：全部计算与数据均留在本机，
  无需外网即可完成上传、阅读、OCR 与检索。
end note
@enduml
