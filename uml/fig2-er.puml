' ==========================================================
' 图 2-13a  文档与 OCR 域 E-R 图
' 建议幅面：通栏 14.6 x 12 cm（约 3/4 页；若超出，删掉解释性 note 后重新出图）
' 说明：属性前缀 * 表示必填(NOT NULL)，o 表示可选；<<PK>>/<<FK>>/<<UQ>> 为键约束
' ==========================================================
@startuml 图2-13a_文档与OCR域E-R图
title 图2-13a  文档与 OCR 域 E-R 图

left to right direction

skinparam defaultFontName "Microsoft YaHei"
skinparam defaultFontSize 26
skinparam shadowing false
skinparam ArrowFontSize 22
skinparam ArrowColor #2C3E50
skinparam DefaultFontColor #1F2933
skinparam EntityBackgroundColor #EAF2F8
skinparam EntityBorderColor #5D6D7E
skinparam NoteBackgroundColor #FCF3CF

entity "sys_user" as user {
  * user_id : CHAR(32) <<PK>>
  * username : VARCHAR(64) <<UQ>>
  * password_hash : VARCHAR(255)
  o email : VARCHAR(128)
  * status : TINYINT
  * created_at : DATETIME
}

entity "ocr_files" as file {
  * id : CHAR(32) <<PK>>
  * owner_id : VARCHAR(128) <<FK>> <<IDX>>
  * name : VARCHAR(255)
  * storage_key : VARCHAR(100)
  * media_type : VARCHAR(40)
  * sha256 : CHAR(64)
  * size : INT UNSIGNED
  * page_count : INT UNSIGNED
  o active_job_id : CHAR(32) <<FK>>
  * generation : INT 默认 0
  * created_at : DATETIME
  o deleted_at : DATETIME
}

entity "ocr_jobs" as job {
  * id : CHAR(32) <<PK>>
  * file_id : CHAR(32) <<FK>> <<IDX>>
  * generation : INT
  * owner_id : VARCHAR(128) <<IDX>>
  * status : VARCHAR(24) 默认 'queued'
  * options : JSON
  * attempts : INT 默认 0
  o lease_token : CHAR(32)
  o lease_until : DATETIME
  * available_at : DATETIME
  * created_at : DATETIME
  o finished_at : DATETIME
  --
  * idx ix_ocr_queue (status, available_at, lease_until)
}

entity "ocr_pages" as page {
  * id : CHAR(32) <<PK>>
  * job_id : CHAR(32) <<FK>> <<IDX>>
  * page_no : INT
  * status : VARCHAR(16) 默认 'pending'
  * revision : INT 默认 0
  o result : JSON
  o error : VARCHAR(80)
  --
  * uq (job_id, page_no)
}

entity "pdf_text_index" as idx {
  * id : CHAR(32) <<PK>>
  * file_id : CHAR(32) <<FK>> <<IDX>>
  * page_no : INT
  * job_id : CHAR(32) <<FK>>
  * revision : INT
  * content : LONGTEXT
  * updated_at : DATETIME
  --
  * uq (file_id, page_no)
  * ft 全文索引 ngram(content)
}

entity "file_category" as cat {
  * id : CHAR(32) <<PK>>
  * name : VARCHAR(64)
  o parent_id : CHAR(32) <<FK>>
  * sort_no : INT 默认 0
  --
  * uq (parent_id, name)
  * 层级 ≤ 5，禁止成环
}

user ||--o{ file : "拥有"
file ||--o{ job : "发起（最多 1 个活动任务）"
job ||--|{ page : "包含（1..N）"
file ||--o{ idx : "按页建立索引"
page ||..o| idx : "成功后回写"
cat ||--o{ file : "归类"
cat ||--o{ cat : "父分类（自引用）"

note bottom of job
  status ∈ {queued, running, retry_wait,
  succeeded, partial_success, failed, cancelled}
end note
@enduml


' ==========================================================
' 图 2-13b  账号权限与记账域 E-R 图
' 建议幅面：通栏 14.6 x 9 cm（约 2/3 页）
' ==========================================================
@startuml 图2-13b_标签与分享域E-R图
title 图2-13b  标签与分享域 E-R 图

skinparam defaultFontName "Microsoft YaHei"
skinparam defaultFontSize 26
skinparam shadowing false
skinparam ArrowFontSize 22
skinparam ArrowColor #2C3E50
skinparam DefaultFontColor #1F2933
skinparam EntityBackgroundColor #EAF2F8
skinparam EntityBorderColor #5D6D7E
skinparam NoteBackgroundColor #FCF3CF

entity "ocr_files（节选）" as file2 {
  * id : CHAR(32) <<PK>>
  * name : VARCHAR(255)
  * owner_id : VARCHAR(128) <<FK>>
}

entity "dict_tag" as tag {
  * id : CHAR(32) <<PK>>
  * name : VARCHAR(32) <<UQ>>
  o color : CHAR(7)
}

entity "file_tag_rel" as rel {
  * file_id : CHAR(32) <<FK>>
  * tag_id : CHAR(32) <<FK>>
  --
  * pk (file_id, tag_id)
}

entity "share_link" as share {
  * id : CHAR(32) <<PK>>
  * file_id : CHAR(32) <<FK>>
  * token : CHAR(64) <<UQ>>
  * expires_at : DATETIME
  * allow_download : TINYINT 默认 0
  * revoked : TINYINT 默认 0
  * visit_count : INT 默认 0
}

file2 ||--o{ share : "生成分享"
file2 }o--o{ rel : "打标签"
tag ||--o{ rel : "被引用"

note bottom of rel
  多对多联系必须有中间实体；
  (file_id, tag_id) 构成联合主键，同时防止重复打标。
end note
@enduml


' ==========================================================
' 图 2-13c  账号权限与记账域 E-R 图
' ==========================================================
@startuml 图2-13c_账号权限与记账域E-R图
title 图2-13c  账号、权限与记账域 E-R 图

skinparam defaultFontName "Microsoft YaHei"
skinparam defaultFontSize 26
skinparam shadowing false
skinparam ArrowFontSize 22
skinparam ArrowColor #2C3E50
skinparam DefaultFontColor #1F2933
skinparam EntityBackgroundColor #EAF2F8
skinparam EntityBorderColor #5D6D7E
skinparam NoteBackgroundColor #FCF3CF

entity "sys_user" as user {
  * user_id : CHAR(32) <<PK>>
  * username : VARCHAR(64) <<UQ>>
  * password_hash : VARCHAR(255)
  * failed_attempts : INT 默认 0
  o locked_until : DATETIME
  * created_at : DATETIME
}

entity "sys_role" as role {
  * role_code : VARCHAR(16) <<PK>>
  * role_name : VARCHAR(32)
  * can_write : TINYINT
  --
  * role_code ∈ {user, viewer, admin}
}

entity "user_role_rel" as ur {
  * user_id : CHAR(32) <<FK>>
  * role_code : VARCHAR(16) <<FK>>
  --
  * pk (user_id, role_code)
}

entity "quota_usage" as quota {
  * user_id : CHAR(32) <<FK>>
  * period : CHAR(7) 如 '2026-10'
  * pages_reserved : INT 默认 0
  * pages_used : INT 默认 0
  * storage_bytes : BIGINT 默认 0
  * updated_at : DATETIME
  --
  * pk (user_id, period)
  * chk pages_reserved ≥ 0
}

entity "ocr_audit_log" as audit {
  * id : CHAR(32) <<PK>>
  * actor_id : VARCHAR(128) <<IDX>>
  * action : VARCHAR(40)
  * resource_id : CHAR(32)
  o detail : JSON
  * created_at : DATETIME
  --
  * action ∈ {file_upload, job_created,
    job_cancelled, job_retried,
    page_corrected, export, search, share...}
}

user ||--o{ ur : "拥有角色"
role ||--o{ ur : "授予给"
user ||--|| quota : "每周期一条账"
user ||--o{ audit : "留痕（actor_id）"

note right of quota
  配额采用「预留 → 结算 → 退还」三段式记账：
  入队前预留页数，任务取消时退还，终态时结算。
end note

note bottom of audit
  审计日志只追加、不可修改，
  detail 中不记录文件正文与令牌等敏感内容，保留 180 天。
end note
@enduml
