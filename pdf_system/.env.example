# 主系统配置（复制为 .env 后按需修改）
PDF_DATABASE_URL=mysql+pymysql://pdf_user:pdf_pwd@127.0.0.1/pdf_system?charset=utf8mb4
# 至少 32 字符；必须与 OCR 模块共用同一把密钥
PDF_JWT_SECRET=please-replace-with-a-32-char-random-secret
PDF_JWT_ISSUER=pdf-system
PDF_JWT_AUDIENCE=ocr-api
PDF_JWT_EXPIRE_MINUTES=120
PDF_STORAGE_DIR=./data/storage
PDF_MAX_UPLOAD_BYTES=20971520
PDF_MAX_PAGES=100
PDF_MONTHLY_PAGE_QUOTA=500

# OCR 模块装配（丙）
PDF_OCR_ENABLED=true
PDF_OCR_PACKAGE_DIR=../pdf_ocr_module
PDF_OCR_DEVICE=cpu
