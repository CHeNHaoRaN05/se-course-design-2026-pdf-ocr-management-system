  "components": {
    "schemas": {
      "Block": {
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Id"
          },
          "text": {
            "type": "string",
            "maxLength": 10000,
            "title": "Text"
          },
          "confidence": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Confidence"
          },
          "bbox": {
            "items": {
              "type": "number"
            },
            "type": "array",
            "maxItems": 4,
            "minItems": 4,
            "title": "Bbox"
          },
          "needs_review": {
            "type": "boolean",
            "title": "Needs Review",
            "default": true
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "text",
          "confidence",
          "bbox"
        ],
        "title": "Block"
      },
      "Body_upload_api_v1_ocr_files_post": {
        "properties": {
          "file": {
            "type": "string",
            "format": "binary",
            "title": "File"
          }
        },
        "type": "object",
        "required": [
          "file"
        ],
        "title": "Body_upload_api_v1_ocr_files_post"
      },
      "Correction": {
        "properties": {
          "expected_revision": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Expected Revision"
          },
          "blocks": {
            "items": {
              "$ref": "#/components/schemas/Block"
            },
            "type": "array",
            "maxItems": 2000,
            "title": "Blocks"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "expected_revision",
          "blocks"
        ],
        "title": "Correction"
      },
      "FileOut": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "media_type": {
            "type": "string",
            "title": "Media Type"
          },
          "size": {
            "type": "integer",
            "title": "Size"
          },
          "page_count": {
            "type": "integer",
            "title": "Page Count"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          }
        },
        "type": "object",
        "required": [
          "id",
          "name",
          "media_type",
          "size",
          "page_count",
          "created_at"
        ],
        "title": "FileOut"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "JobCreate": {
        "properties": {
          "file_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{32}$",
            "title": "File Id"
          },
          "pages": {
            "anyOf": [
              {
                "items": {
                  "type": "integer"
                },
                "type": "array",
                "maxItems": 100,
                "minItems": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Pages"
          },
          "mode": {
            "type": "string",
            "enum": [
              "general",
              "handwriting"
            ],
            "title": "Mode",
            "default": "general"
          },
          "recognition_model": {
            "type": "string",
            "enum": [
              "official",
              "custom"
            ],
            "title": "Recognition Model",
            "default": "official"
          },
          "dpi": {
            "type": "integer",
            "maximum": 240.0,
            "minimum": 72.0,
            "title": "Dpi",
            "default": 144
          },
          "tables": {
            "type": "boolean",
            "title": "Tables",
            "default": false
          },
          "min_confidence": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Min Confidence",
            "default": 0.5
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "file_id"
        ],
        "title": "JobCreate"
      },
      "JobOut": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "file_id": {
            "type": "string",
            "title": "File Id"
          },
          "status": {
            "type": "string",
            "enum": [
              "queued",
              "running",
              "retry_wait",
              "succeeded",
              "partial_success",
              "failed",
